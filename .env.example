# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered
CONTACT_ADMIN_EMAIL=marketing@ssbwings.com

# Verified sender on your Resend domain (fallback: onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=SSBWINGS <noreply@ssbwings.com>

# ─────────────────────────────────────────────────────────────
# Supabase — powers the admin CMS (content, auth, image storage)
# Project → Settings → API. Create a free project at https://supabase.com
# ─────────────────────────────────────────────────────────────
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-or-publishable-key

# SERVER ONLY — never expose. Used for admin user management (create admins).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# Storage bucket name for uploaded media (create it in Supabase → Storage)
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
